# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code 개인 설정 (팀 공용 .claude/settings.json은 올려도 됨)
.claude/settings.local.json
CLAUDE.local.md

# 로그: 서울시 API는 인증키가 주소 안에 들어가서 로그에 키가 찍힐 수 있음
*.log

# 지도 변환 스크립트의 중간 결과물
/data/tmp/

# 행정동 경계 원본 (34MB, 내려받는 주소는 README·docs/05)
/data/raw/HangJeongDong_*.geojson